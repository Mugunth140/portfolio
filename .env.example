# ╔══════════════════════════════════════════════════════════════════════════════╗
# ║  Environment Variables Template                                              ║
# ║  Copy this file to .env.local and fill in the values                         ║
# ╚══════════════════════════════════════════════════════════════════════════════╝

# ─────────────────────────────────────────────────────────────────────────────────
# Resend Email Configuration
# Get your API key from: https://resend.com/api-keys
# ─────────────────────────────────────────────────────────────────────────────────

# Your Resend API key (required for contact form)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Email sender address (must be from a verified domain in Resend)
CONTACT_EMAIL_FROM=hello@mugunth.live

# Email recipient address (where contact form submissions are sent)
CONTACT_EMAIL_TO=your@personalemail.com

# ─────────────────────────────────────────────────────────────────────────────────
# Docker Hub (for CI/CD pipeline)
# ─────────────────────────────────────────────────────────────────────────────────

# Your Docker Hub username
DOCKERHUB_USERNAME=yourusername

# ─────────────────────────────────────────────────────────────────────────────────
# GitHub Actions Secrets Required
# Add these in: GitHub → Settings → Secrets → Actions
# ─────────────────────────────────────────────────────────────────────────────────
#
# DOCKERHUB_USERNAME    - Your Docker Hub username
# DOCKERHUB_TOKEN       - Docker Hub access token (not password)
# SSH_HOST              - Azure VM IP address or hostname
# SSH_USER              - SSH username (e.g., azureuser)
# SSH_PRIVATE_KEY       - Private SSH key for VM access
# RESEND_API_KEY        - Resend API key
# CONTACT_EMAIL_FROM    - Sender email address
# CONTACT_EMAIL_TO      - Recipient email address
